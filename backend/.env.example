# Database
DATABASE_URL=postgresql://birhan:birhan@localhost:5432/birhan

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-long!!
BETTER_AUTH_URL=http://localhost:3000

# JWT (used for custom claims)
JWT_SECRET=your-jwt-secret-min-32-chars-long!!

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_RESOURCES=church-docs
S3_BUCKET_PASTOR_DOCS=pastor-docs

# Phone normalization
DEFAULT_COUNTRY_CODE=+251

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Email verification (set to true in production)
EMAIL_VERIFICATION_REQUIRED=false

# Node env
NODE_ENV=development

# Better Auth Infrastructure (optional — sends auth events to external service)
# WARNING: This sends sensitive auth data (IPs, geo, login events) to Better Auth's servers.
# Not recommended for church data without reviewing data residency requirements.
BETTER_AUTH_API_KEY=
BETTER_AUTH_API_URL=https://api.better-auth.com
BETTER_AUTH_KV_URL=https://kv.better-auth.com

# ---------------------------------------------------------------------------
# Email verification (SMTP)
# ---------------------------------------------------------------------------
# Wired for Resend. Brevo is the same shape — swap the host and the login.
#
#   Resend  SMTP_HOST=smtp.resend.com   SMTP_USER=resend        SMTP_PASS=<api key>
#   Brevo   SMTP_HOST=smtp-relay.brevo.com  SMTP_USER=<login>   SMTP_PASS=<smtp key>
#
# Leave these blank and signup still works: the account is created, the link is
# written to the log instead of being mailed, and the user can resend later.
# Never put any of this in the app's .env — EXPO_PUBLIC_* values ship inside
# the APK and are readable by anyone who downloads it.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# true only for port 465 (implicit TLS). 587 upgrades via STARTTLS.
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=

# The From address. Its domain needs SPF and DKIM records or Gmail bins the
# mail — see RUNBOOK.md.
EMAIL_FROM=noreply@birhan.online
EMAIL_FROM_NAME=Birhan

# Origin the verification link points at. Must be reachable from a phone and a
# desktop browser, so not localhost in anything but development.
PUBLIC_API_URL=https://api.birhan.online

# Custom scheme the app registers (app.json → expo.scheme). Used by the
# "Open Birhan" button on the verification page.
APP_SCHEME=birhan

# How long a verification link stays valid, and how many resends one account
# may trigger per hour.
EMAIL_TOKEN_TTL_HOURS=24
EMAIL_RESEND_PER_HOUR=3

# --- Telegram --------------------------------------------------------------
# One bot serves every church. Two separate things depend on it:
#   1. Linking a church's GROUP to a church (a short code the pastor posts).
#   2. Verifying a PERSON's Telegram identity during registration.
#
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Given to Telegram in setWebhook and returned on every update as
# X-Telegram-Bot-Api-Secret-Token. The webhook route is public; this header is
# the only thing separating a real update from anyone who guesses the URL.
TELEGRAM_WEBHOOK_SECRET=

# The bot's @name, WITHOUT the @ — e.g. BirhanBot.
#
# REQUIRED FOR REGISTRATION. It builds the deep link (https://t.me/<name>?start=…)
# that the signup flow hands to the user, and it is the one place the bot has to
# be addressed by name rather than by token. Registration FAILS CLOSED without
# it: /api/v1/auth/telegram/start answers 503 TELEGRAM_DISABLED and no account
# can be created. That is deliberate — a server that cannot check Telegram must
# refuse to register people, not waive the check — but it does mean this is a
# deployment prerequisite, not an optional extra.
TELEGRAM_BOT_USERNAME=

# How long a link code (group linking) stays good, and how many one church may
# generate per hour.
TELEGRAM_CODE_TTL_MINUTES=10
TELEGRAM_CODES_PER_HOUR=6

# How long an unfinished registration survives before it expires and the user
# has to start again. It is holding a password hash and contact details for
# someone who does not have an account yet, so this is minutes, not days.
PENDING_REGISTRATION_TTL_MINUTES=10

# Registrations one IP may start per hour.
REGISTRATION_STARTS_PER_HOUR=10
