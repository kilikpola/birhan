# Backend API (Postgres + Better Auth, self-hosted — see ../backend)
EXPO_PUBLIC_API_URL=https://api.birhan.online

# Sentry (optional — monitoring is a no-op without EXPO_PUBLIC_SENTRY_DSN)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_RATE=

# Build metadata / flags
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_ENABLE_DEBUG=false
EXPO_PUBLIC_COMMIT_SHA=
