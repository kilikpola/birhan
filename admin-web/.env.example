# Copy to .env.local and fill in. Same Supabase project as the mobile app.
# The ANON key is safe in a client — RLS (super_admin policies) is what protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Error monitoring (Sentry) ---
# DSN is safe to ship in a client bundle. Leave blank to disable monitoring.
VITE_SENTRY_DSN=
# Environment label shown on every event (staging | production). Defaults to Vite MODE.
VITE_ENV=
# Commit SHA for the release; CI injects this at build time.
VITE_COMMIT_SHA=

# --- Build-time source-map upload (CI only; NOT shipped to the client) ---
# Provided as CI secrets/vars, not in .env.local. Without SENTRY_AUTH_TOKEN the
# Vite plugin is disabled and the build still succeeds.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=birhan-admin
